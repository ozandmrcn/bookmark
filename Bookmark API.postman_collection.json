              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookmark"
              ]
            },
            "description": "### Create Bookmark\nCreates a bookmark for the authenticated user and saves `bookmarkId`."
          },
          "response": []
        },
        {
          "name": "Get Bookmarks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var res = pm.response.json();",
                  "",
                  "pm.test('Returns a non-empty array of bookmarks', function () {",
                  "    pm.expect(res).to.be.an('array');",
                  "    pm.expect(res.length).to.be.above(0);",
                  "});",
                  "",
                  "if (Array.isArray(res) && res.length > 0) {",
                  "    pm.test('Each bookmark has the core fields', function () {",
                  "        pm.expect(res[0]).to.have.property('id');",
                  "        pm.expect(res[0]).to.have.property('title');",
                  "        pm.expect(res[0]).to.have.property('link');",
                  "        pm.expect(res[0]).to.have.property('userId');",
                  "    });",
                  "}",
                  "",
                  "pm.test('The created bookmark is present in the list', function () {",
                  "    var found = res.some(function (b) {",
                  "        return String(b.id) === pm.collectionVariables.get('bookmarkId');",
                  "    });",
                  "    pm.expect(found).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"

    {
      "name": "Logout Service",
      "description": "Terminates the authenticated session. **Kept last on purpose**: logout revokes the server-side tokens (deletes the stored refresh token and blacklists the access token), so every request that needs a valid token must run before it.",
      "item": [
        {
          "name": "Log Out",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Logout returns a success message', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.message).to.eql('User Logged Out');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"

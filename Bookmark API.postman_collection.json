    {
      "name": "Auth Service",
      "description": "User lifecycle: registration, login, and bearer JWT refresh. Logout lives at the end of the collection since it revokes the session.",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a fresh email per run to avoid duplicate-key errors.",
                  "pm.collectionVariables.set('userEmail', 'user_' + Date.now() + '@bookmark.dev');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    pm.test('Signup returns user data + tokens', function () {",
                  "        pm.expect(res.message).to.eql('User Signed Up');",
                  "        pm.expect(res.user).to.be.an('object');",
                  "        pm.expect(res.user).to.not.have.property('hash');",
                  "        pm.expect(res.accessToken).to.be.a('string');",
                  "        pm.expect(res.refreshToken).to.be.a('string');",
                  "        pm.expect(res.user.id).to.be.a('number');",
                  "        pm.expect(res.user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    });",
                  "",
                  "    if (res.accessToken) pm.collectionVariables.set('token', res.accessToken);",
                  "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "    if (res.user && res.user.id) pm.collectionVariables.set('userId', String(res.user.id));",
                  "} else {",
                  "    pm.test('Error response is shaped correctly', function () {",
                  "        var err = pm.response.json();",
                  "        pm.expect(err).to.have.property('message');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"password123\",\n    \"firstName\": \"Ozan\",\n    \"lastName\": \"Demircan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "### Register User\nRegisters a new user. Saves `token`, `refreshToken` and `userId`."
          },
          "response": []
        },
        {
          "name": "Log In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.test('Login returns user data + tokens', function () {",
                  "        pm.expect(res.message).to.eql('User Logged In');",
                  "        pm.expect(res.user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "        pm.expect(res.user).to.not.have.property('hash');",
                  "        pm.expect(res.accessToken).to.be.a('string');",
                  "        pm.expect(res.refreshToken).to.be.a('string');",
                  "    });",
                  "",
                  "    if (res.accessToken) pm.collectionVariables.set('token', res.accessToken);",
                  "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "    if (res.user && res.user.id) pm.collectionVariables.set('userId', String(res.user.id));",
                  "} else {",
                  "    pm.test('Error response is shaped correctly', function () {",
                  "        var err = pm.response.json();",
                  "        pm.expect(err).to.have.property('message');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "### User Login\nLogs in with the credentials created during Sign Up. Saves `token`, `refreshToken` and `userId`."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.test('Returns a fresh token pair', function () {",
                  "        pm.expect(res.message).to.eql('Token Refreshed');",
                  "        pm.expect(res.accessToken).to.be.a('string');",
                  "        pm.expect(res.refreshToken).to.be.a('string');",
                  "    });",
                  "",
                  "    if (res.accessToken) pm.collectionVariables.set('token', res.accessToken);",
                  "    if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "} else {",
                  "    pm.test('401/403 when the refresh token is missing or expired', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refreshToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "### Refresh Token\nObtains a fresh pair of tokens by sending the `refreshToken` as a **Bearer** token (matching the `jwt-refresh` Passport strategy). The refresh token is **rotated**: the old one is revoked server-side and a new one is stored. Saves the new `token` and `refreshToken`."
          },
          "response": []
        }
      ]
    },
